# NEXOS CRM - Configuração ICP (Template - Sem Credenciais Reais)
# Copie para /opt/nexoscrm-config/app.env na VPS e preencha com valores reais
# Nunca commit este arquivo com senhas reais

# Runtime
NODE_ENV=production
PORT=3026
LOG_LEVEL=info

# Database (PostgreSQL no container postgresql_17)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Dentro da rede Docker, use: postgresql_17:5432
DATABASE_URL=postgresql://nexoscrm:SENHA_NEXOSCRM@postgresql_17:5432/nexoscrm?schema=public

DB_HOST=postgresql_17
DB_PORT=5432
DB_NAME=nexoscrm
DB_USER=nexoscrm
# DB_PASS será lido de DATABASE_URL, não defina aqui para maior segurança

# JWT Secret (Gere um valor seguro via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=GERAR_UM_VALOR_SEGURO_AQUI

# URLs
FRONTEND_URL=https://nexos.chorstconsult.com.br
API_URL=https://nexos.chorstconsult.com.br/api

# Opcional: Variáveis adicionais conforme necessário
# CORS_ORIGINS=https://nexos.chorstconsult.com.br
# MAX_JSON_SIZE=150mb

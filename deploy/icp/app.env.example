# Docker --env-file: no quotes, no export. Secrets are runtime only.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://nexos_icp:REPLACE_PERCENT_ENCODED_PASSWORD@postgresql_17:5432/nexos_icp?schema=public
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CORS_ORIGIN=https://nexos.chorstconsult.com.br
FRONTEND_URL=https://nexos.chorstconsult.com.br
API_URL=https://nexos.chorstconsult.com.br
MASTER_EMAILS=chorstconsult@gmail.com
DISABLE_STARTUP_WRITES=true
UPLOADS_DIR=/app/apps/api/uploads
EDITAIS_ATTACHMENTS_DIR=/app/apps/attachments/editais
# Optional: GEMINI_API_KEY, GOOGLE_API_KEY, OPENAI_API_KEY,
# PORTAL_TRANSPARENCIA_TOKEN, MERCADOPAGO_ACCESS_TOKEN,
# MERCADOPAGO_PUBLIC_KEY, MERCADOPAGO_WEBHOOK_SECRET.

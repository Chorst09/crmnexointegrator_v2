{
  "name": "nexoscrm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "NODE_ENV=production tsx server.ts",
    "build": "npm run build:web",
    "build:pptx": "node scripts/build-pptx-template.cjs",
    "build:web": "node scripts/build-pptx-template.cjs && cd apps/web && npm run build",
    "lint": "node --check scripts/build-pptx-template.cjs && node --check apps/api/server.cjs",
    "start": "tsx server.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "vite": "^7.3.5"
  },
  "dependencies": {
    "express": "^4.18.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2"
  }
}
